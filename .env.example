# ════════════════════════════════════════════════════════
# Lidi Studio — Environment Variables (template)
# ════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit real secrets.
# All secrets stored on the Hetzner host at /opt/lidi/.env (mode 600).
# Reference: /docs/platform-architecture-v1.md §9.4

# ────────────────────────────────────────────────────────
# Site / domain
# ────────────────────────────────────────────────────────
SITE_URL=https://lidi.studio
SITE_NAME="Lidi Studio"
NODE_ENV=production
TZ=America/Anchorage

# ────────────────────────────────────────────────────────
# Hetzner host (only used by deploy workflow)
# ────────────────────────────────────────────────────────
HETZNER_HOST=
HETZNER_SSH_PORT=2222
HETZNER_SSH_USER=lidi
# Path to deploy key — store the key itself in GitHub Secrets, not here
# HETZNER_SSH_KEY_PATH=

# ────────────────────────────────────────────────────────
# Cloudflare (DNS · CDN · WAF · R2 backups)
# ────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 (S3-compatible) for Restic backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lidi-studio-backups
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# ────────────────────────────────────────────────────────
# PostgreSQL (shared instance · per-service databases)
# ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=lidi
POSTGRES_PASSWORD=
# Per-service databases (created by infra/postgres/init-databases.sh)
POSTGRES_DB_GHOST=ghost
POSTGRES_DB_CALCOM=calcom
POSTGRES_DB_DOCUSEAL=docuseal
POSTGRES_DB_NOCODB=nocodb
POSTGRES_DB_UMAMI=umami

# ────────────────────────────────────────────────────────
# Redis (Cal.com sessions · Ghost cache)
# ────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ────────────────────────────────────────────────────────
# Ghost (journal CMS at /journal)
# ────────────────────────────────────────────────────────
GHOST_URL=https://lidi.studio/journal
GHOST_CONTENT_API_KEY=
GHOST_ADMIN_API_KEY=
# Webhook secret for Ghost → Astro rebuild trigger
GHOST_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────
# Cal.com (booking at /book)
# ────────────────────────────────────────────────────────
CALCOM_LICENSE_CONSENT=agree
CALCOM_NEXTAUTH_SECRET=
CALCOM_ENCRYPTION_KEY=
CALCOM_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────
# DocuSeal (contracts at /contracts/[token])
# ────────────────────────────────────────────────────────
DOCUSEAL_SECRET_KEY_BASE=
DOCUSEAL_WEBHOOK_SECRET=

# ────────────────────────────────────────────────────────
# NocoDB (CRM at /admin)
# ────────────────────────────────────────────────────────
NOCODB_AUTH_JWT_SECRET=
# Caddy basic auth for /admin (in addition to NocoDB native auth)
NOCODB_BASIC_AUTH_USER=
NOCODB_BASIC_AUTH_PASSWORD_HASH=

# ────────────────────────────────────────────────────────
# Umami (analytics at /stats)
# ────────────────────────────────────────────────────────
UMAMI_APP_SECRET=
UMAMI_WEBSITE_ID=

# ────────────────────────────────────────────────────────
# Brevo SMTP (300/day free outbound)
# ────────────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Lidi Studio <lidi@lidi.studio>"
SMTP_REPLY_TO=lidi@lidi.studio

# ────────────────────────────────────────────────────────
# Stripe (payments — deposits + balances)
# ────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_

# Stripe products / prices (created in Stripe Dashboard, IDs pasted here)
STRIPE_PRICE_HEARTH_DEPOSIT=
STRIPE_PRICE_BECOMING_DEPOSIT=
STRIPE_PRICE_FIRSTLIGHT_DEPOSIT=
STRIPE_PRICE_MOTHERING_DEPOSIT=
STRIPE_PRICE_TRIPTYCH_DEPOSIT=

# ────────────────────────────────────────────────────────
# Astro / NocoDB API access for /api/inquiry handler
# ────────────────────────────────────────────────────────
NOCODB_API_URL=http://nocodb:8080/api/v2
NOCODB_API_TOKEN=

# ────────────────────────────────────────────────────────
# Telegram bot (alerts · uptime · deploy notifications)
# ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ────────────────────────────────────────────────────────
# Restic (backup encryption)
# ────────────────────────────────────────────────────────
# Long random passphrase — store also in 1Password + sealed offline envelope
RESTIC_PASSWORD=
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/lidi-studio-backups

# ────────────────────────────────────────────────────────
# GitHub (CI/CD)
# ────────────────────────────────────────────────────────
# These live in GitHub Actions Secrets, not in .env on the host.
# Listed here for completeness:
# - HETZNER_SSH_PRIVATE_KEY
# - HETZNER_HOST
# - GHCR_TOKEN  (Personal Access Token with packages:write)
